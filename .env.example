# GOOGLE_MAPS_API_KEY: Google Maps Platform API key used on the server for Places API (New) and Routes API.
# AI Studio automatically injects this when Google Maps is provisioned.
GOOGLE_MAPS_API_KEY=""

# VITE_GOOGLE_MAPS_API_KEY: Public browser-scoped Google Maps JavaScript API key (restricted by HTTP referrer).
VITE_GOOGLE_MAPS_API_KEY=""

# MURF_API_KEY: Optional server-side API key for Murf Falcon 2 TTS voices (en-IN, hi-IN, ta-IN).
# When unset, the app gracefully falls back to browser speech synthesis so reviewers can still hear the host.
MURF_API_KEY=""

# GEMINI_API_KEY: Server-side key for the Voice AI Agent (/api/agent/turn and /api/agent/quiz).
# AI Studio automatically injects this at runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AGENT_MODEL: Optional Gemini model override for the Voice AI Agent (default: gemini-4-hydrogen).
AGENT_MODEL="gemini-4-hydrogen"

# ANTHROPIC_API_KEY / CLAUDE_MODEL: Optional alternative LLM provider if deploying outside AI Studio.
# ANTHROPIC_API_KEY=""
# CLAUDE_MODEL="claude-opus-5-5"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
